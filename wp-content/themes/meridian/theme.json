{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "78rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "base", "color": "#ffffff", "name": "White" },
				{ "slug": "mist", "color": "#f4f6f8", "name": "Mist" },
				{ "slug": "line", "color": "#dde3ea", "name": "Rule" },
				{ "slug": "slate", "color": "#55657a", "name": "Slate" },
				{ "slug": "ink", "color": "#0e2338", "name": "Ink" },
				{ "slug": "ink-deep", "color": "#081726", "name": "Deep ink" },
				{ "slug": "accent", "color": "#a8763a", "name": "Brass" },
				{ "slug": "accent-soft", "color": "#f0e7db", "name": "Soft brass" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "\"Charter\", \"Bitstream Charter\", \"Iowan Old Style\", \"Source Serif Pro\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "X Small", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": { "min": "1.125rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "1.875rem",
					"fluid": { "min": "1.5rem", "max": "2.125rem" }
				},
				{
					"slug": "xx-large",
					"name": "XX Large",
					"size": "2.75rem",
					"fluid": { "min": "2rem", "max": "3.25rem" }
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4rem",
					"fluid": { "min": "2.5rem", "max": "4.5rem" }
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.75rem" },
				{ "slug": "30", "name": "2", "size": "1.25rem" },
				{ "slug": "40", "name": "3", "size": "2rem" },
				{ "slug": "50", "name": "4", "size": "3.25rem" },
				{ "slug": "60", "name": "5", "size": "5rem" },
				{ "slug": "70", "name": "6", "size": "7rem" },
				{ "slug": "80", "name": "7", "size": "9rem" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 1px 2px rgba(14,35,56,.05), 0 8px 24px rgba(14,35,56,.06)" },
				{ "slug": "lift", "name": "Lift", "shadow": "0 2px 4px rgba(14,35,56,.06), 0 18px 40px rgba(14,35,56,.10)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"letterSpacing": "-0.005em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 3.5rem)",
				"right": "clamp(1.25rem, 5vw, 3.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"border": { "radius": "3px" },
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": { "padding": { "top": "0.9em", "bottom": "0.9em", "left": "2em", "right": "2em" } },
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.04em",
					"textDecoration": "none"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base)" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--slate)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.375rem",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.02em"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "2px", "style": "solid" } },
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.5"
				}
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/post-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.875rem" },
				"color": { "background": "var(--wp--preset--color--mist)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page — full width", "postTypes": [ "page" ] },
		{ "name": "page-contact", "title": "Page — contact", "postTypes": [ "page" ] }
	]
}
